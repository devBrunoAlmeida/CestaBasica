@page "/usuarios"
@using System.Net.Http.Json
@using CestaBasica.Shared.DTOs
@using CestaBasica.Shared.Enums
@using Microsoft.AspNetCore.Components.Routing
@inject HttpClient Http

<div class="space-y-6">

    <!-- Cabeçalho da Página -->
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Administração de Usuários</h1>
            <p class="text-sm text-slate-500 mt-0.5">
                Gerencie acessos, perfis e permissões dos usuários do sistema.
            </p>
        </div>

        <button type="button"
                class="h-10 px-4 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold text-sm rounded-xl shadow-xs transition-all cursor-pointer inline-flex items-center gap-2 self-start sm:self-auto"
                @onclick="AbrirCadastro">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span>Novo usuário</span>
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(mensagemFeedback))
    {
        <div class="flex items-center gap-2.5 p-4 rounded-xl text-sm font-medium @(erroFeedback ? "bg-red-50 border border-red-200 text-red-700" : "bg-emerald-50 border border-emerald-200 text-emerald-700")">
            @if (erroFeedback)
            {
                <svg class="w-5 h-5 shrink-0 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            }
            else
            {
                <svg class="w-5 h-5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            }
            <span>@mensagemFeedback</span>
        </div>
    }

    <!-- Card de Filtro / Busca -->
    <section class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-5">
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Busca dinâmica</label>
        <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
            </div>
            <input type="text"
                   placeholder="Pesquisar por nome, e-mail ou perfil..."
                   @bind="busca"
                   @bind:event="oninput"
                   class="w-full h-10 pl-10 pr-4 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all" />
        </div>
    </section>

    <!-- Formulário / Modal Inline de Cadastro e Edição -->
    @if (exibirFormulario)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 backdrop-blur-xs p-4 overflow-y-auto">
            <section class="w-full max-w-lg mx-4 bg-white rounded-2xl border border-slate-200/80 shadow-xl p-6 space-y-5 my-8">
                <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-4">
                    <div>
                        <h2 class="text-lg font-bold text-slate-900">@(editando ? "Editar usuário" : "Cadastrar novo usuário")</h2>
                        <span class="text-xs text-slate-500">Defina os dados de acesso e permissões administrativas.</span>
                    </div>
                    <button type="button"
                            @onclick="Cancelar"
                            class="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 cursor-pointer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Nome completo</label>
                        <input type="text"
                               @bind="usuarioForm.Nome"
                               placeholder="Digite o nome do usuário"
                               class="w-full h-10 px-3.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all" />
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">E-mail</label>
                        <input type="email"
                               @bind="usuarioForm.Email"
                               placeholder="usuario@empresa.com.br"
                               class="w-full h-10 px-3.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all" />
                    </div>

                    <div class="sm:col-span-2">
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">@(editando ? "Nova senha (opcional)" : "Senha")</label>
                        <input type="password"
                               @bind="usuarioForm.Senha"
                               placeholder="@(editando ? "Deixe em branco para manter" : "Digite a senha")"
                               class="w-full h-10 px-3.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Perfil</label>
                        <select @bind="usuarioForm.Perfil"
                                class="w-full h-10 px-3.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all">
                            <option value="Admin">Administrador</option>
                            <option value="Usuario">Operador / Usuário</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Status</label>
                        <select @bind="usuarioForm.Ativo"
                                class="w-full h-10 px-3.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all">
                            <option value="true">Ativo</option>
                            <option value="false">Inativo</option>
                        </select>
                    </div>
                </div>

                <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-3">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-600">Controle de permissões</h3>

                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
                        <label class="flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
                            <input type="checkbox" class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" @bind="usuarioForm.Permissoes.Funcionarios" />
                            <span>Funcionários</span>
                        </label>
                        <label class="flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
                            <input type="checkbox" class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" @bind="usuarioForm.Permissoes.Retiradas" />
                            <span>Retiradas</span>
                        </label>
                        <label class="flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
                            <input type="checkbox" class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" @bind="usuarioForm.Permissoes.Notificacoes" />
                            <span>Notificações</span>
                        </label>
                        <label class="flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
                            <input type="checkbox" class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" @bind="usuarioForm.Permissoes.Relatorios" />
                            <span>Relatórios</span>
                        </label>
                        <label class="flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer">
                            <input type="checkbox" class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" @bind="usuarioForm.Permissoes.Usuarios" />
                            <span>Usuários</span>
                        </label>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 pt-2 border-t border-slate-100">
                    <button type="button"
                            class="h-10 px-4 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-medium text-sm rounded-xl transition-all cursor-pointer"
                            @onclick="Cancelar">
                        Cancelar
                    </button>

                    <button type="button"
                            class="h-10 px-5 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold text-sm rounded-xl shadow-xs transition-all cursor-pointer"
                            @onclick="SalvarUsuario">
                        Salvar usuário
                    </button>
                </div>
            </section>
        </div>
    }

    <!-- Card da Tabela de Usuários -->
    <section class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-5 sm:p-6 space-y-4">
        <div>
            <h2 class="text-base font-bold text-slate-900">Usuários cadastrados</h2>
            <span class="text-xs text-slate-500">Listagem de usuários autorizados na plataforma.</span>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-200">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50/80 border-b border-slate-200 text-xs font-semibold uppercase tracking-wider text-slate-500 whitespace-nowrap">
                    <tr>
                        <th class="py-3 px-4">Usuário</th>
                        <th class="py-3 px-4">E-mail</th>
                        <th class="py-3 px-4">Perfil</th>
                        <th class="py-3 px-4">Status</th>
                        <th class="py-3 px-4">Permissões</th>
                        <th class="py-3 px-4 text-right">Ações</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100 bg-white text-sm text-slate-700">
                    @foreach (var usuario in UsuariosFiltrados)
                    {
                        <tr class="hover:bg-slate-50/80 transition-colors">
                            <td class="py-3.5 px-4 whitespace-nowrap">
                                <strong class="block font-semibold text-slate-900">@usuario.Nome</strong>
                                <small class="text-xs text-slate-400 tabular-nums">ID: @usuario.Id</small>
                            </td>

                            <td class="py-3.5 px-4 text-slate-600 whitespace-nowrap">@usuario.Email</td>

                            <td class="py-3.5 px-4 whitespace-nowrap">
                                @if (usuario.Perfil == "Admin")
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
                                        Administrador
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                                        Operador
                                    </span>
                                }
                            </td>

                            <td class="py-3.5 px-4 whitespace-nowrap">
                                @if (usuario.Ativo)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                        Inativo
                                    </span>
                                }
                            </td>

                            <td class="py-3.5 px-4">
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var permissao in usuario.Permissoes.ListarAtivas())
                                    {
                                        <span class="px-2 py-0.5 rounded-md text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200/80">
                                            @permissao
                                        </span>
                                    }
                                </div>
                            </td>

                            <td class="py-3.5 px-4 whitespace-nowrap text-right">
                                <div class="inline-flex items-center justify-end gap-1">
                                    <button type="button"
                                            title="Editar"
                                            class="p-2 rounded-lg text-slate-500 hover:text-blue-600 hover:bg-blue-50 transition-colors cursor-pointer"
                                            @onclick="() => EditarUsuario(usuario)">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </button>

                                    <button type="button"
                                            title="Excluir"
                                            class="p-2 rounded-lg text-slate-500 hover:text-red-600 hover:bg-red-50 transition-colors cursor-pointer"
                                            @onclick="() => ExcluirUsuario(usuario.Id)">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

</div>

@code {
    private string busca = "";
    private bool exibirFormulario = false;
    private bool editando = false;
    private string? mensagemFeedback;
    private bool erroFeedback = false;

    private UsuarioViewModel usuarioForm = new();
    private List<UsuarioViewModel> usuarios = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarUsuarios();
    }

    private async Task CarregarUsuarios()
    {
        try
        {
            var lista = await Http.GetFromJsonAsync<List<UsuarioListItemDto>>("api/usuarios/listar") ?? new();
            usuarios = lista.Select(u => new UsuarioViewModel
            {
                Id = u.Id,
                Nome = u.Nome,
                Email = u.Email,
                Perfil = u.Perfil,
                Ativo = u.Ativo,
                Permissoes = u.Perfil == "Admin"
                    ? PermissoesUsuario.AdminPadrao()
                    : PermissoesUsuario.OperadorPadrao()
            }).ToList();
        }
        catch (Exception ex)
        {
            erroFeedback = true;
            mensagemFeedback = $"Erro ao carregar usuários: {ex.Message}";
        }
    }

    private IEnumerable<UsuarioViewModel> UsuariosFiltrados =>
        usuarios.Where(u =>
            string.IsNullOrWhiteSpace(busca) ||
            u.Nome.Contains(busca, StringComparison.OrdinalIgnoreCase) ||
            u.Email.Contains(busca, StringComparison.OrdinalIgnoreCase) ||
            u.Perfil.Contains(busca, StringComparison.OrdinalIgnoreCase)
        );

    private void AbrirCadastro()
    {
        editando = false;
        mensagemFeedback = null;
        usuarioForm = new UsuarioViewModel
        {
            Perfil = "Usuario",
            Ativo = true,
            Permissoes = PermissoesUsuario.OperadorPadrao()
        };

        exibirFormulario = true;
    }

    private void EditarUsuario(UsuarioViewModel usuario)
    {
        editando = true;
        mensagemFeedback = null;

        usuarioForm = new UsuarioViewModel
        {
            Id = usuario.Id,
            Nome = usuario.Nome,
            Email = usuario.Email,
            Perfil = usuario.Perfil,
            Ativo = usuario.Ativo,
            Permissoes = usuario.Permissoes.Clone()
        };

        exibirFormulario = true;
    }

    private async Task SalvarUsuario()
    {
        mensagemFeedback = null;
        erroFeedback = false;

        var perfilEnum = usuarioForm.Perfil == "Admin" ? PerfilUsuario.Admin : PerfilUsuario.Usuario;

        HttpResponseMessage response;
        if (editando)
        {
            var dto = new UsuarioUpdateDto
            {
                Id = usuarioForm.Id,
                Nome = usuarioForm.Nome,
                Email = usuarioForm.Email,
                NovaSenha = string.IsNullOrWhiteSpace(usuarioForm.Senha) ? null : usuarioForm.Senha,
                Perfil = perfilEnum,
                Ativo = usuarioForm.Ativo
            };
            response = await Http.PutAsJsonAsync($"api/usuarios/{usuarioForm.Id}", dto);
        }
        else
        {
            var dto = new UsuarioCreateDto
            {
                Nome = usuarioForm.Nome,
                Email = usuarioForm.Email,
                Senha = usuarioForm.Senha,
                Perfil = perfilEnum,
                Ativo = usuarioForm.Ativo
            };
            response = await Http.PostAsJsonAsync("api/usuarios/criar", dto);
        }

        if (!response.IsSuccessStatusCode)
        {
            var erro = await response.Content.ReadFromJsonAsync<ErroApiDto>();
            erroFeedback = true;
            mensagemFeedback = erro?.Mensagem ?? "Erro ao salvar usuário.";
            return;
        }

        exibirFormulario = false;
        mensagemFeedback = editando ? "Usuário atualizado com sucesso." : "Usuário cadastrado com sucesso.";
        await CarregarUsuarios();
    }

    private async Task ExcluirUsuario(int id)
    {
        mensagemFeedback = null;
        var response = await Http.DeleteAsync($"api/usuarios/{id}");
        if (response.IsSuccessStatusCode)
        {
            erroFeedback = false;
            mensagemFeedback = "Usuário excluído com sucesso.";
            await CarregarUsuarios();
        }
        else
        {
            erroFeedback = true;
            mensagemFeedback = "Não foi possível excluir o usuário.";
        }
    }

    private void Cancelar()
    {
        exibirFormulario = false;
    }

    public class UsuarioViewModel
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Senha { get; set; } = "";
        public string Perfil { get; set; } = "Usuario";
        public bool Ativo { get; set; } = true;
        public PermissoesUsuario Permissoes { get; set; } = new();
    }

    public class PermissoesUsuario
    {
        public bool Funcionarios { get; set; }
        public bool Retiradas { get; set; }
        public bool Notificacoes { get; set; }
        public bool Relatorios { get; set; }
        public bool Usuarios { get; set; }

        public static PermissoesUsuario AdminPadrao() => new()
        {
            Funcionarios = true,
            Retiradas = true,
            Notificacoes = true,
            Relatorios = true,
            Usuarios = true
        };

        public static PermissoesUsuario OperadorPadrao() => new()
        {
            Funcionarios = true,
            Retiradas = true,
            Notificacoes = true
        };

        public List<string> ListarAtivas()
        {
            var lista = new List<string>();

            if (Funcionarios) lista.Add("Funcionários");
            if (Retiradas) lista.Add("Retiradas");
            if (Notificacoes) lista.Add("Notificações");
            if (Relatorios) lista.Add("Relatórios");
            if (Usuarios) lista.Add("Usuários");

            return lista;
        }

        public PermissoesUsuario Clone()
        {
            return new PermissoesUsuario
            {
                Funcionarios = Funcionarios,
                Retiradas = Retiradas,
                Notificacoes = Notificacoes,
                Relatorios = Relatorios,
                Usuarios = Usuarios
            };
        }
    }
}
