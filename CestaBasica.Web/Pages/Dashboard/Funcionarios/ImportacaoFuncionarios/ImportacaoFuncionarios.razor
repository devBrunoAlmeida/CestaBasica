@page "/importacao"
@namespace CestaBasica.Web.Pages.Dashboard.Funcionarios.ImportacaoFuncionarios
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
@using CestaBasica.Shared.DTOs

<div class="space-y-6">

    <!-- Cabeçalho -->
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Importação de Planilhas</h1>
            <p class="text-sm text-slate-500 mt-0.5">Carregue arquivos Excel ou CSV para cadastro e atualização de registros no sistema.</p>
        </div>

        <button type="button"
                @onclick='() => Navigation.NavigateTo("/funcionarios")'
                class="h-10 px-4 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-medium text-sm rounded-xl transition-all cursor-pointer inline-flex items-center gap-2 self-start sm:self-auto">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span>Voltar para Funcionários</span>
        </button>
    </header>

    <!-- Área de Upload -->
    <section class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-6">
        <div class="border-2 border-dashed border-slate-200 hover:border-blue-400 rounded-2xl p-8 text-center transition-colors bg-slate-50/50">

            <div style="@(arquivoSelecionado is null ? "" : "display:none")" class="max-w-md mx-auto space-y-3">
                <div class="w-12 h-12 mx-auto rounded-2xl bg-blue-50 border border-blue-100 text-blue-600 flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                    </svg>
                </div>
                <h2 class="text-base font-bold text-slate-900">Arraste e solte sua planilha aqui</h2>
                <p class="text-xs text-slate-500">Formatos aceitos: Excel (.xlsx, .xls) e CSV (.csv)</p>
                <div class="pt-2">
                    <label class="h-10 px-4 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold text-sm rounded-xl shadow-xs transition-all cursor-pointer inline-flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                        </svg>
                        <span>Selecionar arquivo</span>
                        <InputFile OnChange="SelecionarArquivo" accept=".xlsx,.xls,.csv" class="hidden" />
                    </label>
                </div>
            </div>

            <div style="@(arquivoSelecionado is not null ? "" : "display:none")" class="max-w-lg mx-auto space-y-4">
                <div class="w-12 h-12 mx-auto rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-600 flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <h2 class="text-base font-bold text-slate-900">Arquivo pronto para importação</h2>

                <div class="flex items-center justify-between gap-3 p-4 rounded-xl bg-white border border-slate-200 text-left shadow-xs">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                            </svg>
                        </div>
                        <div class="min-w-0">
                            <strong class="block text-sm font-semibold text-slate-900 truncate">@nomeArquivo</strong>
                            <p class="text-xs text-slate-500">Clique em "Importar registros válidos" para processar</p>
                        </div>
                    </div>

                    <button type="button"
                            class="p-2 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors cursor-pointer shrink-0"
                            title="Remover arquivo"
                            @onclick="RemoverArquivo">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>

        </div>
    </section>

    <!-- Cards de Resumo -->
    <section class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div class="bg-white rounded-2xl border border-emerald-200/80 shadow-xs p-5 flex items-center justify-between">
            <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-emerald-700">Registros válidos</span>
                <h2 class="text-3xl font-extrabold text-emerald-700 tabular-nums mt-1">@validos</h2>
            </div>
            <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
            </div>
        </div>

        <div class="bg-white rounded-2xl border border-red-200/80 shadow-xs p-5 flex items-center justify-between">
            <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-red-700">Registros inválidos</span>
                <h2 class="text-3xl font-extrabold text-red-700 tabular-nums mt-1">@invalidos</h2>
            </div>
            <div class="w-11 h-11 rounded-xl bg-red-50 text-red-600 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
        </div>

        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-5 flex items-center justify-between">
            <div>
                <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Total analisado</span>
                <h2 class="text-3xl font-extrabold text-slate-900 tabular-nums mt-1">@total</h2>
            </div>
            <div class="w-11 h-11 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
            </div>
        </div>
    </section>

    <!-- Pré-visualização da planilha -->
    <section class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-5 sm:p-6 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div>
                <h2 class="text-base font-bold text-slate-900">Pré-visualização da planilha</h2>
                <span class="text-xs text-slate-500">Validação automática dos dados antes da importação.</span>
            </div>

            <button type="button"
                    class="h-10 px-4 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 disabled:opacity-50 text-white font-semibold text-sm rounded-xl shadow-xs transition-all cursor-pointer inline-flex items-center justify-center gap-2"
                    @onclick="ImportarRegistrosValidos"
                    disabled="@importando">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                <span>@(importando ? "Importando..." : "Importar registros válidos")</span>
            </button>
        </div>

        @if (progresso > 0)
        {
            <div class="p-4 rounded-xl bg-blue-50/50 border border-blue-100 space-y-2">
                <div class="flex items-center justify-between text-xs font-semibold text-blue-700">
                    <span>Importando registros...</span>
                    <strong class="tabular-nums">@progresso%</strong>
                </div>
                <div class="w-full h-2 bg-blue-100 rounded-full overflow-hidden">
                    <div class="h-full bg-blue-600 rounded-full transition-all duration-300" style="width:@progresso%"></div>
                </div>
            </div>
        }

        <div class="overflow-x-auto rounded-xl border border-slate-200">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50/80 border-b border-slate-200 text-xs font-semibold uppercase tracking-wider text-slate-500 whitespace-nowrap">
                    <tr>
                        <th class="py-3 px-4">Linha</th>
                        <th class="py-3 px-4">Nome</th>
                        <th class="py-3 px-4">Matrícula</th>
                        <th class="py-3 px-4">Código de barras</th>
                        <th class="py-3 px-4">Telefone</th>
                        <th class="py-3 px-4">Setor</th>
                        <th class="py-3 px-4">Status</th>
                        <th class="py-3 px-4">Erros</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white text-sm text-slate-700">
                    @if (!registros.Any())
                    {
                        <tr>
                            <td colspan="8" class="py-10 px-4 text-center text-sm text-slate-400">
                                Nenhum arquivo carregado ainda.
                            </td>
                        </tr>
                    }
                    @foreach (RegistroImportacaoDto item in registros)
                    {
                        <tr class="@(item.Valido ? "hover:bg-slate-50/80" : "bg-red-50/40 hover:bg-red-50/70") transition-colors">
                            <td class="py-3 px-4 tabular-nums font-medium text-slate-500">@item.Linha</td>
                            <td class="py-3 px-4 font-semibold text-slate-900 whitespace-nowrap">@item.Nome</td>
                            <td class="py-3 px-4 tabular-nums whitespace-nowrap">@item.Matricula</td>
                            <td class="py-3 px-4 font-mono text-xs whitespace-nowrap">@item.CodigoBarras</td>
                            <td class="py-3 px-4 tabular-nums whitespace-nowrap">@item.Telefone</td>
                            <td class="py-3 px-4 whitespace-nowrap">@item.Setor</td>
                            <td class="py-3 px-4 whitespace-nowrap">
                                @if (item.Valido)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                        Válido
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                        Inválido
                                    </span>
                                }
                            </td>
                            <td class="py-3 px-4 text-xs text-red-600">@item.Erro</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- Histórico de importações recentes -->
    <section class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-5 sm:p-6 space-y-4">
        <div>
            <h2 class="text-base font-bold text-slate-900">Histórico de importações recentes</h2>
            <span class="text-xs text-slate-500">Controle das últimas operações realizadas.</span>
        </div>

        <div class="divide-y divide-slate-100">
            @if (historico.Any())
            {
                @foreach (var item in historico)
                {
                    <div class="py-3.5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center shrink-0">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                            </div>
                            <div>
                                <strong class="block text-sm font-semibold text-slate-900">@item.NomeArquivo</strong>
                                <p class="text-xs text-slate-500">@item.DataImportacao.ToString("dd/MM/yyyy HH:mm") — @item.Usuario</p>
                            </div>
                        </div>

                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 self-start sm:self-auto">
                            @item.QuantidadeRegistros registros
                        </span>
                    </div>
                }
            }
            else
            {
                <p class="py-6 text-center text-sm text-slate-400">Nenhuma importação realizada até o momento.</p>
            }
        </div>
    </section>

</div>
