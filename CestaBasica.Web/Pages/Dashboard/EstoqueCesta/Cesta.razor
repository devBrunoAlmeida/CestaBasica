@page "/cestas"
@using CestaBasica.Shared.DTOs
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web

<div class="space-y-6">

    <!-- Cabeçalho da Página -->
    <header class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Controle de Cestas Básicas</h1>
            <p class="text-sm text-slate-500 mt-0.5">Cadastro de lotes mensais, estoque disponível e status de distribuição.</p>
        </div>
    </header>

    <!-- Destaque do Lote Ativo Vigente -->
    @{
        var loteVigente = cestas.FirstOrDefault(c => c.Ativa);
        var maiorEstoque = cestas.Any() ? Math.Max(cestas.Max(c => c.QuantidadeDisponivel), 1000) : 1000;
    }
    @if (loteVigente is not null)
    {
        var percentualVigente = Math.Clamp((loteVigente.QuantidadeDisponivel * 100.0) / Math.Max(maiorEstoque, 1), 5, 100);
        <section class="rounded-2xl border border-blue-200 bg-blue-50/30 p-5 sm:p-6 shadow-xs flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
            <div class="space-y-2 max-w-2xl">
                <div class="flex flex-wrap items-center gap-2.5">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        Lote Ativo Vigente
                    </span>
                    <span class="text-xs text-slate-500">
                        Criado em @loteVigente.DataCriacao.ToString("dd/MM/yyyy")
                    </span>
                </div>
                <h2 class="text-lg font-bold text-slate-900">@loteVigente.Nome</h2>
                <p class="text-sm text-slate-600">@loteVigente.Descricao</p>
            </div>

            <div class="w-full lg:w-72 bg-white rounded-xl border border-blue-100 p-4 space-y-2.5 shrink-0">
                <div class="flex items-baseline justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Saldo Disponível</span>
                    <strong class="text-2xl font-extrabold text-blue-700 tabular-nums">@loteVigente.QuantidadeDisponivel</strong>
                </div>
                <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full bg-blue-600 rounded-full transition-all duration-500"
                         style="width: @($"{percentualVigente.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%")">
                    </div>
                </div>
                <span class="block text-[11px] text-slate-400">Unidades prontas para retirada imediata</span>
            </div>
        </section>
    }

    <!-- Card: Novo Lote de Cesta -->
    <section class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-5 sm:p-6 space-y-5">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 border border-blue-100 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
            </div>
            <div>
                <h2 class="text-base font-bold text-slate-900">Novo lote de cesta</h2>
                <p class="text-xs text-slate-500">Registre uma nova remessa ou competência mensal no estoque.</p>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="sm:col-span-2">
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Nome do lote</label>
                <input type="text"
                       @bind="novaCesta.Nome"
                       placeholder="Ex: Cesta Básica Mensal - Dezembro/2026"
                       class="w-full h-10 px-3.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all" />
            </div>

            <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Quantidade disponível</label>
                <input type="number"
                       @bind="novaCesta.QuantidadeDisponivel"
                       class="w-full h-10 px-3.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all tabular-nums" />
            </div>

            <div class="sm:col-span-3">
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1.5">Descrição</label>
                <textarea rows="2"
                          @bind="novaCesta.Descricao"
                          placeholder="Ex: Cesta básica mensal familiar referente à competência vigente"
                          class="w-full p-3.5 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all"></textarea>
            </div>
        </div>

        <div class="flex justify-end">
            <button type="button"
                    class="h-10 px-5 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white font-semibold text-sm rounded-xl shadow-xs transition-all cursor-pointer inline-flex items-center gap-2"
                    @onclick="CadastrarCesta">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                <span>Cadastrar lote</span>
            </button>
        </div>
    </section>

    <!-- Tabela de Lotes Cadastrados -->
    <section class="bg-white rounded-2xl border border-slate-200/80 shadow-xs p-5 sm:p-6 space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h2 class="text-base font-bold text-slate-900">Lotes cadastrados</h2>
                <span class="text-xs text-slate-500">Total: <strong class="font-semibold text-slate-800 tabular-nums">@cestas.Count</strong> lote(s)</span>
            </div>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-200">
            <table class="w-full text-left border-collapse">
                <thead class="bg-slate-50/80 border-b border-slate-200 text-xs font-semibold uppercase tracking-wider text-slate-500 whitespace-nowrap">
                    <tr>
                        <th class="py-3 px-4">Nome</th>
                        <th class="py-3 px-4">Descrição</th>
                        <th class="py-3 px-4">Estoque disponível</th>
                        <th class="py-3 px-4">Data criação</th>
                        <th class="py-3 px-4">Status</th>
                        <th class="py-3 px-4 text-right">Ações</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-slate-100 bg-white text-sm text-slate-700">
                    @foreach (var cesta in cestas)
                    {
                        var percEstoque = Math.Clamp((cesta.QuantidadeDisponivel * 100.0) / Math.Max(maiorEstoque, 1), 0, 100);
                        <tr class="@(cesta.Ativa ? "bg-blue-50/20 hover:bg-blue-50/40" : "hover:bg-slate-50/80") transition-colors">
                            @if (cestaEditandoId == cesta.Id)
                            {
                                <td class="py-3 px-4">
                                    <input class="w-full min-w-[180px] h-9 px-3 rounded-lg border border-slate-300 bg-white text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600"
                                           @bind="cesta.Nome" />
                                </td>

                                <td class="py-3 px-4">
                                    <input class="w-full min-w-[220px] h-9 px-3 rounded-lg border border-slate-300 bg-white text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600"
                                           @bind="cesta.Descricao" />
                                </td>

                                <td class="py-3 px-4">
                                    <input type="number"
                                           class="w-28 h-9 px-3 rounded-lg border border-slate-300 bg-white text-sm text-slate-900 tabular-nums focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600"
                                           @bind="cesta.QuantidadeDisponivel" />
                                </td>

                                <td class="py-3 px-4 tabular-nums whitespace-nowrap text-slate-500">
                                    @cesta.DataCriacao.ToString("dd/MM/yyyy")
                                </td>

                                <td class="py-3 px-4 whitespace-nowrap">
                                    @if (cesta.Ativa)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                            Ativa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                            Desativada
                                        </span>
                                    }
                                </td>

                                <td class="py-3 px-4 whitespace-nowrap text-right">
                                    <div class="inline-flex items-center justify-end gap-1">
                                        <button type="button"
                                                title="Salvar"
                                                class="p-2 rounded-lg text-emerald-600 hover:bg-emerald-50 transition-colors cursor-pointer"
                                                @onclick="() => SalvarEdicao(cesta)">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                            </svg>
                                        </button>

                                        <button type="button"
                                                title="Cancelar"
                                                class="p-2 rounded-lg text-slate-500 hover:text-red-600 hover:bg-red-50 transition-colors cursor-pointer"
                                                @onclick="CancelarEdicao">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            }
                            else
                            {
                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    <strong class="font-semibold text-slate-900">@cesta.Nome</strong>
                                </td>

                                <td class="py-3.5 px-4 text-slate-600 max-w-md">
                                    @cesta.Descricao
                                </td>

                                <td class="py-3.5 px-4 whitespace-nowrap min-w-[160px]">
                                    <div class="space-y-1">
                                        <span class="font-bold text-slate-900 tabular-nums">@cesta.QuantidadeDisponivel un.</span>
                                        <div class="w-28 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                            <div class="h-full @(cesta.Ativa ? "bg-blue-600" : "bg-slate-400") rounded-full"
                                                 style="width: @($"{percEstoque.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%")">
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td class="py-3.5 px-4 tabular-nums whitespace-nowrap text-slate-500">
                                    @cesta.DataCriacao.ToString("dd/MM/yyyy")
                                </td>

                                <td class="py-3.5 px-4 whitespace-nowrap">
                                    @if (cesta.Ativa)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                            Ativa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-50 text-red-700 border border-red-200">
                                            <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                            Desativada
                                        </span>
                                    }
                                </td>

                                <td class="py-3.5 px-4 whitespace-nowrap text-right">
                                    <div class="inline-flex items-center justify-end gap-1">
                                        @if (cesta.Ativa)
                                        {
                                            <button type="button"
                                                    title="Desativar lote"
                                                    class="p-2 rounded-lg text-slate-500 hover:text-amber-600 hover:bg-amber-50 transition-colors cursor-pointer"
                                                    @onclick="() => DesativarCesta(cesta.Id)">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
                                                </svg>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    title="Ativar novamente"
                                                    class="p-2 rounded-lg text-slate-500 hover:text-emerald-600 hover:bg-emerald-50 transition-colors cursor-pointer"
                                                    @onclick="() => AtivarCesta(cesta.Id)">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                                </svg>
                                            </button>
                                        }

                                        <button type="button"
                                                title="Editar"
                                                class="p-2 rounded-lg text-slate-500 hover:text-blue-600 hover:bg-blue-50 transition-colors cursor-pointer"
                                                @onclick="() => EditarCesta(cesta.Id)">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                            </svg>
                                        </button>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

</div>
