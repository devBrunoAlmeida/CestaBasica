@page "/login"

@using CestaBasica.Web.Models.Requests
@using CestaBasica.Web.Components.Layout
@using CestaBasica.Shared.Enums
@using CestaBasica.Web.Services
@using Microsoft.AspNetCore.Components.Forms

@layout EmptyLayout

@inject UsuarioApiService UsuarioService
@inject NavigationManager Navigation

<div class="min-h-screen w-full flex bg-slate-50 text-slate-900 antialiased">

    <!-- Painel Esquerdo: Institucional & Branding -->
    <div
        class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white p-12 xl:p-16 flex-col justify-between">
        
        <!-- Elementos decorativos sutis de fundo -->
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
        <div
            class="absolute -bottom-32 -right-24 w-[28rem] h-[28rem] bg-indigo-500/15 rounded-full blur-3xl pointer-events-none">
        </div>
        <div
            class="absolute inset-0 bg-[radial-gradient(#ffffff12_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none">
        </div>

        <!-- Topo: Tag Institucional -->
        <div class="relative z-10 flex items-center gap-3">
            <div
                class="w-10 h-10 rounded-xl bg-blue-600/25 border border-blue-400/30 flex items-center justify-center text-blue-300 shadow-inner">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
            </div>
            <span class="text-sm font-semibold tracking-wider uppercase text-blue-200/90">
                Gestão de Benefícios Sociais
            </span>
        </div>

        <!-- Centro: Proposta de Valor -->
        <div class="relative z-10 max-w-xl my-auto">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/15 text-xs font-medium text-blue-200 mb-6 backdrop-blur-sm">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Plataforma Integrada de Controle e Entrega
            </div>

            <h1 class="text-4xl xl:text-5xl font-extrabold tracking-tight leading-[1.15] text-white mb-6">
                Distribuição de
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-cyan-200">
                    Cestas Básicas
                </span>
            </h1>

            <p class="text-base xl:text-lg text-slate-300 leading-relaxed mb-4">
                Solução corporativa desenvolvida para otimizar processos, ampliar a transparência operacional e garantir
                maior eficiência na administração de programas de assistência.
            </p>

            <p class="text-sm text-slate-400">
                Tecnologia e gestão para promover solidariedade, agilidade no atendimento e impacto social.
            </p>
        </div>

        <!-- Rodapé: Pilares (Badges Glassmorphism) -->
        <div class="relative z-10 grid grid-cols-3 gap-4 pt-8 border-t border-white/10">
            <div
                class="flex items-center gap-3 px-4 py-3 rounded-xl bg-white/5 border border-white/10 backdrop-blur-sm">
                <div class="p-2 rounded-lg bg-blue-500/20 text-blue-300">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-white">Segurança</p>
                    <p class="text-xs text-slate-400">Acesso auditado</p>
                </div>
            </div>

            <div
                class="flex items-center gap-3 px-4 py-3 rounded-xl bg-white/5 border border-white/10 backdrop-blur-sm">
                <div class="p-2 rounded-lg bg-emerald-500/20 text-emerald-300">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-white">Transparência</p>
                    <p class="text-xs text-slate-400">Rastreio por lote</p>
                </div>
            </div>

            <div
                class="flex items-center gap-3 px-4 py-3 rounded-xl bg-white/5 border border-white/10 backdrop-blur-sm">
                <div class="p-2 rounded-lg bg-amber-500/20 text-amber-300">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-semibold text-white">Eficiência</p>
                    <p class="text-xs text-slate-400">Baixa instantânea</p>
                </div>
            </div>
        </div>

    </div>

    <!-- Painel Direito: Formulário de Autenticação -->
    <div class="w-full lg:w-1/2 flex items-center justify-center p-6 sm:p-10">

        <div
            class="w-full max-w-md bg-white rounded-2xl border border-slate-200/80 shadow-xl shadow-slate-200/50 p-8 sm:p-10">

            <!-- Cabeçalho do Card -->
            <div class="text-center mb-8">
                <div
                    class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 shadow-xs">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                </div>

                <h2 class="text-xl font-bold text-slate-900 tracking-tight leading-snug">
                    Acesso ao Sistema
                </h2>
                <p class="text-xs sm:text-sm text-slate-500 mt-1.5 leading-relaxed">
                    Sistema de Apoio à Gestão de Programas de Distribuição de Cestas Básicas
                </p>
            </div>

            <!-- Formulário -->
            <EditForm Model="login" OnValidSubmit="ExecutarLogin" FormName="loginForm" class="space-y-5">

                <!-- Perfil de Acesso (Segmented Control Moderno) -->
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">
                        Perfil de Acesso
                    </label>
                    <InputRadioGroup @bind-Value="login.Perfil">
                        <div class="grid grid-cols-2 gap-2.5 p-1 bg-slate-100 rounded-xl border border-slate-200/70">
                            <label class="cursor-pointer m-0">
                                <InputRadio Value="@PerfilUsuario.Usuario" class="sr-only peer" />
                                <div
                                    class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg text-sm font-semibold text-slate-600 peer-checked:bg-white peer-checked:text-blue-700 peer-checked:shadow-xs peer-checked:ring-1 peer-checked:ring-slate-200/80 transition-all">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"
                                         viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                    </svg>
                                    Operador
                                </div>
                            </label>

                            <label class="cursor-pointer m-0">
                                <InputRadio Value="@PerfilUsuario.Admin" class="sr-only peer" />
                                <div
                                    class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-lg text-sm font-semibold text-slate-600 peer-checked:bg-white peer-checked:text-blue-700 peer-checked:shadow-xs peer-checked:ring-1 peer-checked:ring-slate-200/80 transition-all">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"
                                         viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                    </svg>
                                    Administrador
                                </div>
                            </label>
                        </div>
                    </InputRadioGroup>
                </div>

                <!-- E-mail -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">
                        E-mail institucional
                    </label>
                    <div class="relative">
                        <div
                            class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <InputText @bind-Value="login.Email" placeholder="nome@cestabasica.com"
                                   class="w-full h-11 pl-10 pr-4 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all" />
                    </div>
                </div>

                <!-- Senha -->
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">
                        Senha
                    </label>
                    <div class="relative">
                        <div
                            class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                        </div>
                        <InputText type="@(mostrarSenha ? "text" : "password")" @bind-Value="login.Senha"
                                   placeholder="••••••••"
                                   class="w-full h-11 pl-10 pr-11 rounded-xl border border-slate-300 bg-white text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 transition-all" />
                        <button type="button" @onclick="() => mostrarSenha = !mostrarSenha"
                                title="Mostrar ou ocultar senha"
                                class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 cursor-pointer">
                            @if (mostrarSenha)
                            {
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                                </svg>
                            }
                            else
                            {
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                          d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <!-- Botão Entrar -->
                <button type="submit" disabled="@carregando"
                        class="w-full h-11 rounded-xl bg-blue-600 hover:bg-blue-700 active:bg-blue-800 disabled:opacity-60 text-white font-semibold text-sm shadow-sm shadow-blue-600/20 transition-all flex items-center justify-center gap-2 cursor-pointer mt-2">
                    @if (carregando)
                    {
                        <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
                            </circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                        </svg>
                        <span>Autenticando...</span>
                    }
                    else
                    {
                        <span>Entrar no Sistema</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    }
                </button>

            </EditForm>

            <!-- Alerta de Erro -->
            @if (!string.IsNullOrEmpty(mensagem))
            {
                <div
                    class="mt-5 flex items-start gap-2.5 p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm">
                    <svg class="w-4 h-4 mt-0.5 shrink-0 text-red-500" fill="none" stroke="currentColor" stroke-width="2"
                         viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round"
                              d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>@mensagem</span>
                </div>
            }

            <!-- Rodapé de Segurança -->
            <div
                class="mt-6 pt-5 border-t border-slate-100 flex items-center justify-center gap-2 text-xs text-slate-500">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2"
                     viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                <span>Ambiente seguro. Seus dados estão protegidos.</span>
            </div>

        </div>

    </div>

</div>

@code {
    // Mantenha o seu bloco @code atual aqui!
    // Adicione apenas estas duas variáveis de UI se ainda não existirem:
    private bool mostrarSenha = false;
    private bool carregando = false;

    private async Task ExecutarLogin()
    {
        carregando = true;
        try
        {
            await FazerLogin();
        }
        finally
        {
            carregando = false;
        }
    }
}